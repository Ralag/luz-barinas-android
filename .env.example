# LUZ BARINAS - VARIABLES DE ENTORNO
# =========================================================================
# NOTA: debug utiliza siempre unidades de anuncio oficiales de prueba.
# El App ID publico propio se conserva para los mensajes de privacidad UMP.
# Cuando vayas a publicar la app, crea un archivo llamado '.env' (en la raíz)
# y coloca allí tus IDs reales obtenidos de tu consola de AdMob.

# ID de la Aplicación en AdMob (Producción)
ADMOB_APP_ID=ca-app-pub-7639154379634043~9373028299

# ID del Bloque de Anuncios Banner Adaptativo (Producción)
ADMOB_BANNER_UNIT_ID=ca-app-pub-7639154379634043/2005674160

# ID del Bloque de Anuncios Nativo / Interstitial (Test ID por defecto o Producción)
ADMOB_NATIVE_UNIT_ID=ca-app-pub-3940256099942544/2247696110

# Formatos existentes en producción; debug los sustituye por unidades de prueba.
ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-7639154379634043/7853072225
ADMOB_APP_OPEN_UNIT_ID=ca-app-pub-7639154379634043/3577027707

# Unidad de recompensa facilitada por el titular; debug usa la unidad de prueba.
ADMOB_REWARDED_UNIT_ID=ca-app-pub-7639154379634043/4531483312
ADMOB_REWARD_HOURS=12
